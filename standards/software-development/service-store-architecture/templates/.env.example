PROJECT_NAME=jp-service-store
APP_NAME="JP Service Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es_CO
APP_FALLBACK_LOCALE=es

APP_PORT=8080
VITE_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PHPMYADMIN_PORT=8081

CONTAINER_USER=app
HOST_UID=1000
HOST_GID=1000

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=service_store
DB_USERNAME=service_store
DB_PASSWORD=xxxxxxxxxxxxxxxx
DB_ROOT_PASSWORD=xxxxxxxxxxxxxxxx

CACHE_STORE=file
SESSION_DRIVER=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"

INSTALL_DEPENDENCIES=false
RUN_MIGRATIONS=false
RUN_SEEDERS=false

VITE_APP_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
VITE_SENTRY_DSN=

POSTHOG_KEY=
POSTHOG_HOST=
GTM_CONTAINER_ID=

PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
