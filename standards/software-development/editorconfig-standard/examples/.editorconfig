# JP Engineering Framework - EditorConfig Standard v1.0.0

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,sass,less,html,htm,vue,svelte,yml,yaml}]
indent_style = space
indent_size = 2

[*.{php,phtml}]
indent_style = space
indent_size = 4

[*.blade.php]
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = unset

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.{xml,svg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile,GNUmakefile}]
indent_style = tab
indent_size = unset
